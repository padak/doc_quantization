# Copy this file to .env and fill in real values:
#
#   cp env.sample .env
#
# .env is gitignored — never commit real keys. Variables already exported in
# your shell take precedence over values in this file.

# Anthropic API key, needed only for the online commands (submit, status,
# fetch, canary-probe). Offline commands work without it.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key
